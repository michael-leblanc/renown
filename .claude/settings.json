{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(scripts/*)",
      "Bash(./scripts/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Write(**/.env.local)",
      "Read(**/.env.e2e)",
      "Edit(**/.env.e2e)",
      "Write(**/.env.e2e)",
      "Bash(cat *.env*)",
      "Bash(rm *.env*)",
      "Bash(mv *.env*)",
      "Bash(cp *.env*)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
